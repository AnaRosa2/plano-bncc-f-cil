# .env.example for frontend (Vite)
# Copy to `.env.local` or `.env` for local development. Do NOT commit secrets.

# API base url for the frontend to call the backend
VITE_API_URL=http://localhost:3333/
# Exemplo de produção: VITE_API_URL=https://sua-api.onrender.com/

# Any client-facing keys should be prefixed with VITE_. Keep sensitive keys on the backend.
NODE_ENV=development
